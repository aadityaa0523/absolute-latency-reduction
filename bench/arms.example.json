{
  "_comment": "Copy to bench/arms.json and replace the three URLs with the RelayUrl output of each regional stack. Every latency lever is a separate arm so each comparison changes exactly one thing. Region arms use Nova Lite because it is in-Region in us-east-1 and eu-north-1 and is not a reasoning model, so its TTFT is not polluted by thinking time; Mumbai only has the APAC profile for it. Sonnet 5 runs with thinking disabled (set in relay/models.js). gpt-oss-20b is in-Region in all three Regions but is a reasoning model, so it is included for information and the report flags it.",
  "endpoints": {
    "virginia": "https://REPLACE.lambda-url.us-east-1.on.aws/",
    "stockholm": "https://REPLACE.lambda-url.eu-north-1.on.aws/",
    "mumbai": "https://REPLACE.lambda-url.ap-south-1.on.aws/"
  },
  "arms": [
    { "id": "far-buffered", "endpoint": "virginia", "model": "nova-lite-inregion", "stream": false },
    { "id": "far-streamed", "endpoint": "virginia", "model": "nova-lite-inregion", "stream": true },
    { "id": "far-geo-streamed", "endpoint": "virginia", "model": "nova-lite-us", "stream": true },
    { "id": "eu-streamed", "endpoint": "stockholm", "model": "nova-lite-inregion", "stream": true },
    { "id": "mum-streamed", "endpoint": "mumbai", "model": "nova-lite-apac", "stream": true },
    { "id": "mum-prompt-cache", "endpoint": "mumbai", "model": "nova-lite-apac", "stream": true, "promptCache": true, "salt": "run" },
    { "id": "mum-resp-cache", "endpoint": "mumbai", "model": "nova-lite-apac", "stream": true, "responseCache": true, "repeat": 2 },

    { "id": "mum-sonnet", "endpoint": "mumbai", "model": "sonnet-5-global", "stream": true },
    { "id": "mum-sonnet-cache", "endpoint": "mumbai", "model": "sonnet-5-global", "stream": true, "promptCache": true, "salt": "run" },
    { "id": "mum-gptoss", "endpoint": "mumbai", "model": "gpt-oss-20b-inregion", "stream": true },

    { "id": "ping-virginia", "kind": "ping", "endpoint": "virginia", "fresh": true },
    { "id": "ping-stockholm", "kind": "ping", "endpoint": "stockholm", "fresh": true },
    { "id": "ping-mumbai", "kind": "ping", "endpoint": "mumbai", "fresh": true },
    { "id": "ping-mumbai-warm", "kind": "ping", "endpoint": "mumbai", "fresh": false }
  ],
  "comparisons": [
    { "name": "Streaming (Virginia)", "a": "far-buffered", "b": "far-streamed" },
    { "name": "Routing profile in Virginia: in-Region to US geo", "a": "far-streamed", "b": "far-geo-streamed" },
    { "name": "Region: Virginia to Stockholm", "a": "far-streamed", "b": "eu-streamed" },
    { "name": "Region: Stockholm to Mumbai (APAC profile)", "a": "eu-streamed", "b": "mum-streamed" },
    { "name": "Region: Virginia to Mumbai (APAC profile)", "a": "far-streamed", "b": "mum-streamed" },
    { "name": "Prompt cache, Nova Lite (long prefix)", "a": "mum-streamed", "b": "mum-prompt-cache", "strata": ["handbook", "long"] },
    { "name": "Prompt cache, Sonnet 5 (long prefix)", "a": "mum-sonnet", "b": "mum-sonnet-cache", "strata": ["handbook", "long"] },
    { "name": "Response cache hit", "a": "mum-streamed", "b": "mum-resp-cache", "bAttempt": 2 }
  ]
}
